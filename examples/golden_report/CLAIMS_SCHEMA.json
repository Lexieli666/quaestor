{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lexieli666/quaestor/examples/golden_report/CLAIMS_SCHEMA.json",
  "title": "Quaestor claims.json — claim grammar and envelope",
  "description": "Validates claims.json as written by the verifier (docs/REPORT_SCHEMA.md sections 6-7, 02-SPEC.md section 3.10). $defs/claim is the standalone Claim the extractor returns as list[Claim]; $defs/verified_claim adds the matcher's verdict; $defs/developer_claim is a verified claim that came from package.yaml claims: and may carry status not_evaluated. Every object is closed: unevaluatedProperties is false and every enum is exhaustive.",
  "type": "object",
  "required": [
    "schema_version", "package", "version", "configuration", "run_id", "illustrative",
    "tolerances", "grounding", "repairs", "pre_repair", "post_repair", "developer_claims",
    "exclusions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "package": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "version": {"type": "string", "minLength": 1},
    "configuration": {"enum": ["full_agent", "rules_only", "plain_llm"]},
    "run_id": {"type": "string", "minLength": 1},
    "illustrative": {"type": "boolean", "description": "true only in examples/golden_report/."},
    "tolerances": {
      "description": "The defaults applied by the matcher, echoed so a reader can reproduce a verdict.",
      "type": "object",
      "additionalProperties": false,
      "required": ["abs_tol_unit_interval", "abs_tol_percent_0_100", "rel_tol_other"],
      "properties": {
        "abs_tol_unit_interval": {"type": "number", "exclusiveMinimum": 0},
        "abs_tol_percent_0_100": {"type": "number", "exclusiveMinimum": 0},
        "rel_tol_other": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "grounding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre_repair", "post_repair"],
      "properties": {
        "pre_repair": {"$ref": "#/$defs/grounding_figure"},
        "post_repair": {"$ref": "#/$defs/grounding_figure"}
      }
    },
    "repairs": {"type": "array", "items": {"$ref": "#/$defs/repair"}},
    "pre_repair": {
      "description": "Every claim as first extracted and matched.",
      "type": "array",
      "items": {"$ref": "#/$defs/verified_claim"}
    },
    "post_repair": {
      "description": "Every claim after the last repair round; Appendix A renders this list.",
      "type": "array",
      "items": {"$ref": "#/$defs/verified_claim"}
    },
    "developer_claims": {
      "description": "package.yaml claims:, evaluated only under --data.",
      "type": "array",
      "items": {"$ref": "#/$defs/developer_claim"}
    },
    "developer_claims_note": {
      "type": "string",
      "minLength": 1,
      "description": "Why developer_claims is empty or not evaluated; rendered in Appendix D."
    },
    "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}}
  },
  "unevaluatedProperties": false,
  "$defs": {
    "section": {
      "description": "Section identifiers used by claims.json and findings.json.",
      "enum": [
        "summary", "conceptual_soundness", "data_integrity", "outcomes", "sensitivity",
        "findings", "monitoring"
      ]
    },
    "status": {
      "enum": ["verified", "mismatch", "unsupported", "dangling", "unattributed"]
    },
    "claim_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "stable_hash([section, text, value])."
    },
    "citation": {
      "type": ["string", "null"],
      "pattern": "^(\\[\\[art:[0-9a-f]{8}:[a-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_-]+)*(#[A-Za-z0-9_.-]+)?\\]\\]){1,2}$",
      "description": "One [[art:...]], or two adjacent for comparison delta or ratio; null when the sentence carries none."
    },
    "claim": {
      "title": "Claim",
      "description": "A numeric statement in report prose, as the extractor returns it.",
      "$ref": "#/$defs/claim_core",
      "unevaluatedProperties": false
    },
    "claim_core": {
      "type": "object",
      "required": [
        "text", "value", "unit", "metric", "split", "comparison", "citation", "rounding",
        "section", "id", "source"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "The sentence or table row as drafted, citations included."
        },
        "value": {
          "type": "number",
          "description": "The number as written, without thousands separators and without the % sign."
        },
        "unit": {"enum": ["ratio", "percent", "count", "currency", "bp", "months"]},
        "metric": {
          "type": ["string", "null"],
          "description": "What the number measures, from the cited artifact's logical name; null for bare counts."
        },
        "split": {"enum": ["train", "test", "out_of_time", "vintage_holdout", null]},
        "comparison": {
          "enum": ["eq", "delta", "ratio"],
          "description": "eq: value matches the artifact. delta: value matches second minus first. ratio: value matches second divided by first."
        },
        "citation": {"$ref": "#/$defs/citation"},
        "rounding": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Decimals the prose used; widens the tolerance, never narrows it."
        },
        "section": {"$ref": "#/$defs/section"},
        "id": {"$ref": "#/$defs/claim_id"},
        "source": {"enum": ["report", "developer"]}
      }
    },
    "verdict": {
      "type": "object",
      "required": ["status", "artifact_value", "tolerance"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "artifact_value": {
          "type": ["number", "null"],
          "description": "The resolved scalar, or the computed delta or ratio; null unless the citation resolved."
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "description": "The absolute tolerance actually applied."
        }
      }
    },
    "verified_claim": {
      "title": "VerifiedClaim",
      "description": "A Claim plus the deterministic matcher's verdict.",
      "allOf": [{"$ref": "#/$defs/claim_core"}, {"$ref": "#/$defs/verdict"}],
      "unevaluatedProperties": false
    },
    "developer_claim": {
      "title": "VerifiedClaim (source: developer)",
      "description": "A package.yaml claims: entry; not_evaluated is the synthetic-mode status.",
      "allOf": [
        {"$ref": "#/$defs/claim_core"},
        {"$ref": "#/$defs/verdict"},
        {
          "properties": {
            "source": {"const": "developer"},
            "status": {
              "enum": [
                "verified", "mismatch", "unsupported", "dangling", "unattributed",
                "not_evaluated"
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "grounding_figure": {
      "description": "verified / (verified + mismatch + unsupported + dangling + unattributed).",
      "type": "object",
      "additionalProperties": false,
      "required": ["precision", "n_claims", "status_counts", "per_section"],
      "properties": {
        "precision": {"type": "number", "minimum": 0, "maximum": 1},
        "n_claims": {"type": "integer", "minimum": 0},
        "status_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verified", "mismatch", "unsupported", "dangling", "unattributed"],
          "properties": {
            "verified": {"type": "integer", "minimum": 0},
            "mismatch": {"type": "integer", "minimum": 0},
            "unsupported": {"type": "integer", "minimum": 0},
            "dangling": {"type": "integer", "minimum": 0},
            "unattributed": {"type": "integer", "minimum": 0}
          }
        },
        "per_section": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/section"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verified", "n_claims", "precision"],
            "properties": {
              "verified": {"type": "integer", "minimum": 0},
              "n_claims": {"type": "integer", "minimum": 0},
              "precision": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    "repair": {
      "description": "One claim changed by one repair round.",
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "claim_id", "before", "after", "instruction"],
      "properties": {
        "section": {"$ref": "#/$defs/section"},
        "claim_id": {"$ref": "#/$defs/claim_id"},
        "before": {"$ref": "#/$defs/repair_side"},
        "after": {"$ref": "#/$defs/repair_side"},
        "instruction": {"type": "string", "minLength": 1}
      }
    },
    "repair_side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status"],
      "properties": {
        "value": {"type": "number"},
        "status": {"$ref": "#/$defs/status"}
      }
    },
    "exclusion": {
      "description": "A class of numeric token the regex pre-pass deliberately ignored.",
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "examples"],
      "properties": {
        "pattern": {"type": "string", "minLength": 1},
        "examples": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
